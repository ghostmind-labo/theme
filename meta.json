{
  "id": "SyI71QPDugZ4",
  "name": "theme",
  "version": "0.3.0",
  "description": "TUI for switching the terminal stack's colour scheme across Ghostty, herdr and Helix, with WCAG contrast enforcement.",
  "type": "project",
  "tags": [
    "cli",
    "tui",
    "terminal",
    "theme",
    "python"
  ],
  "routines": {
    "install": "bash scripts/install.sh link",
    "uninstall": "bash scripts/install.sh unlink",
    "check": "bash scripts/dev.sh check",
    "test": "bash scripts/dev.sh test",
    "herdr_init": "run herdr init theme --all",
    "herdr_attach": "run herdr attach theme",
    "herdr_terminate": "run herdr terminate theme"
  },
  "herdr": {
    "workspaces": [
      {
        "label": "theme",
        "tabs": [
          {
            "label": "dev",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "main-side",
              "panes": [
                {
                  "name": "editor",
                  "size": "70%",
                  "description": "source under app/theme - TUI, colour maths, target writers"
                },
                {
                  "name": "execution-shell",
                  "focus": true,
                  "description": "ad-hoc commands: theme contrast, theme doctor, run routine check"
                },
                {
                  "name": "watch",
                  "description": "long-running checks - re-run `run routine test` after palette changes"
                }
              ]
            }
          },
          {
            "label": "preview",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "single",
              "panes": [
                {
                  "name": "preview",
                  "description": "dedicated pane for launching the TUI and eyeballing themes at full size"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
